# 复制为 knowledge/.env 或 .env，再填写你自己的服务地址和密钥。
# 该文件只能放占位符，禁止提交真实API Key。

# 阿里百炼/OpenAI兼容接口
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your-dashscope-api-key
MODEL=qwen-plus
ITEM_MODEL=qwen-plus
VL_MODEL=qwen-vl-plus

# 本地模型（Windows示例；按自己的路径修改）
BGE_M3_PATH=D:/models/bge-m3
BGE_RERANKER_LARGE=D:/models/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false
EMBEDDING_DIM=1024

# Milvus
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=appliance_chunks_v2
ITEM_NAME_COLLECTION=appliance_items_v2
ENTITY_NAME_COLLECTION=appliance_entities_v2

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=knowledge_history

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=knowledge-base-v2

# 查询策略：dense为低延迟默认路径；full启用多路召回/RRF/Reranker
QUERY_RETRIEVAL_MODE=dense
MCP_DASHSCOPE_BASE_URL=
IMAGE_MIN_AREA=40000
MAX_CONTEXT_CHARS=12000
